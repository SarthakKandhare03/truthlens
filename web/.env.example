# Copy to `.env.local` (Next.js loads it automatically). Never commit .env.local.

# ---------------------------------------------------------------- blockchain
# Which deployment file in src/lib/chain/deployments/ to use: localhost | amoy
CHAIN_NETWORK=localhost
# JSON-RPC endpoint of that network.
#   local: http://127.0.0.1:8545   (started with `npm run chain`)
#   amoy:  https://rpc-amoy.polygon.technology  (or an Alchemy/Infura URL)
RPC_URL=http://127.0.0.1:8545

# Relayer wallet: the server-side account that pays gas for registrations.
# For the LOCAL chain you can use Hardhat's public test account #0 below. It is
# printed by `npm run chain`, is known to everyone, and holds only fake ETH.
# The server REFUSES to use this key on any other network. For Amoy, use the
# same throwaway key as blockchain/.env DEPLOYER_PRIVATE_KEY (the deployer is
# automatically an allow-listed relayer).
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------- storage
# Where originals are kept: local | s3
STORAGE_DRIVER=local
# Folder for STORAGE_DRIVER=local (default: web/storage)
STORAGE_LOCAL_DIR=
# For STORAGE_DRIVER=s3. Credentials come from the standard AWS variables
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or an IAM role).
S3_BUCKET=
AWS_REGION=us-east-1
# Only for S3-compatible services such as MinIO or Cloudflare R2:
S3_ENDPOINT=

# ---------------------------------------------------------------- index + limits
# SQLite cache file (default: web/data/index-<network>.db). Safe to delete:
# it is rebuilt from the blockchain automatically.
DATABASE_PATH=
MAX_UPLOAD_MB=15
REGISTER_RATE_LIMIT_PER_MINUTE=10
