{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "phash:report": "tsx --conditions=react-server scripts/phash-report.mts",
    "diff:report": "tsx --conditions=react-server scripts/diff-report.mts",
    "live:report": "tsx --conditions=react-server scripts/live-report.mts",
    "benchmark": "tsx --conditions=react-server scripts/benchmark.mts",
    "e2e": "tsx --conditions=react-server scripts/e2e.mts",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "icons": "tsx scripts/generate-icons.mts",
    "ui:check": "tsx scripts/ui-check.mts",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "seed": "tsx scripts/seed.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@react-three/fiber": "^9.8.2",
    "ethers": "^6.17.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
