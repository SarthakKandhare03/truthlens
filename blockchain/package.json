{
  "name": "truthlens-blockchain",
  "version": "1.0.0",
  "private": true,
  "description": "TruthRegistry smart contract, tests and deploy scripts for TruthLens",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "smoke:local": "hardhat run scripts/smoke.ts --network localhost",
    "typecheck": "tsc --noEmit",
    "gas": "hardhat test --gas-stats"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^5.3.3",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.1",
    "mocha": "^12.0.3",
    "typescript": "~5.9"
  }
}
