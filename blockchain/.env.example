# Copy to `.env` and fill in ONLY when deploying to Polygon Amoy.
# Local development (`npm run node` + `npm run deploy:local`) needs none of these.

# RPC endpoint for Polygon Amoy (chain id 80002), e.g. from Alchemy, Infura or
# the public endpoint https://rpc-amoy.polygon.technology
AMOY_RPC_URL=

# Private key of the deployer wallet (0x-prefixed). Use a throwaway testnet
# wallet funded with free POL from https://faucet.polygon.technology
# NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=

# Optional: an extra relayer wallet address to allow-list right after deploy.
# Leave empty if the deployer wallet is also the relayer (the default).
RELAYER_ADDRESS=

# Optional: Etherscan API v2 key, used only by `npx hardhat verify`.
ETHERSCAN_API_KEY=
